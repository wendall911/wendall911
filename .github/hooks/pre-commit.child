#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"

if [[ ! -f "$ROOT_DIR/.github/guardrails.md" ]]; then
    echo "Missing .github/guardrails.md" >&2
    exit 1
fi

if [[ ! -f "$ROOT_DIR/.github/copilot-instructions.md" ]]; then
    echo "Missing .github/copilot-instructions.md" >&2
    exit 1
fi

exit 0
