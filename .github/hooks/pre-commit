#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"

if [[ ! -x "$ROOT_DIR/.github/sync-project-agent-rules.sh" ]]; then
    echo "Missing executable sync/check script: .github/sync-project-agent-rules.sh" >&2
    echo "Run: chmod +x .github/sync-project-agent-rules.sh" >&2
    exit 1
fi

echo "Running agent-rules drift check..."
"$ROOT_DIR/.github/sync-project-agent-rules.sh" check
